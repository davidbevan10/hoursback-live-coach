# Zoom app credentials (General App, user-managed)
ZM_RTMS_CLIENT=
ZM_RTMS_SECRET=
# Webhook "Secret Token" from the app's Event Subscription page
ZOOM_WEBHOOK_SECRET_TOKEN=
PORT=8080
# Where JSONL logs are written (gitignored)
DATA_DIR=./data
# Set to 1 to skip signature checks when testing locally with simulate.ts
SKIP_SIGNATURE_CHECK=0
